{
    "name": "medboubazine/laravel-helpers",
    "type": "library",
    "description": "Laravel helpers",
    "keywords": [
        "laravel-helpers"
    ],
    "license": "proprietary",
    "authors": [
        {
            "name": "Mohammed Boubazine",
            "email": "contact@medboubazine.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "guzzlehttp/guzzle": "^8.2",
        "illuminate/support": "^13.0",
        "illuminate/console": "^13.0",
        "spatie/laravel-sitemap": "^8.2"
    },
    "require-dev": {
        "symfony/var-dumper": "^8.0"
    },
    "autoload": {
        "psr-4": {
            "Medboubazine\\LaravelHelpers\\": "src/"
        }
    },
    "scripts": {
        "git": [
            "git add ./",
            "git commit",
            "git push"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Medboubazine\\LaravelHelpers\\ServiceProvider"
            ]
        }
    }
}