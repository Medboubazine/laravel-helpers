{
    "name": "medboubazine/laravel-helpers",
    "type": "library",
    "description": "Laravel laravel helpers",
    "keywords": [
        "laravel-helpers"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Mohammed Boubazine",
            "email": "contact@medboubazine.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.1.10",
        "guzzlehttp/guzzle": "*",
        "illuminate/support": "*",
        "illuminate/console": "*"
    },
    "require-dev": {
        "symfony/var-dumper": "*"
    },
    "autoload": {
        "psr-4": {
            "Medboubazine\\LaravelHelpers\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Medboubazine\\LaravelHelpers\\ServiceProvider"
            ]
        }
    }
}